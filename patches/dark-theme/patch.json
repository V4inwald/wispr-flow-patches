{
  "$schema": "See patches/README.md for the field reference.",
  "name": "dark-theme",
  "title": "Dark theme",
  "summary": "Repaints the app's fixed colour palette into a dark one, and forces the theme it never selects.",
  "compatibility": {
    "package": "com.wispr.flowapp",
    "version": "2.8.7",
    "minSdk": 33,
    "evidence": "analysis/wispr-flow-2.8.7.md"
  },
  "hooks": [
    {
      "id": "FlowAppTheme.forceDark",
      "class": "com/wispr/design/ThemeKt",
      "why": "Every app screen composes under FlowAppTheme, and several pass dark=false explicitly (MainActivity does). Overwriting the parameter at the entry of the theme makes the explicit case dark without touching any screen.",
      "method": ".method public static final FlowAppTheme(ZZLkotlin/jvm/functions/Function2;Lyo0;II)V",
      "anchor": "    invoke-virtual {p2}, Ljava/lang/Object;->getClass()Ljava/lang/Class;\n",
      "original": "    invoke-virtual {p2}, Ljava/lang/Object;->getClass()Ljava/lang/Class;\n",
      "replacement": "    const/4 p0, 0x1\n\n    invoke-virtual {p2}, Ljava/lang/Object;->getClass()Ljava/lang/Class;\n",
      "marker": "patch:dark-theme:forceDark",
      "returns": "V"
    },
    {
      "id": "isSystemInDarkTheme",
      "class": "ls2",
      "why": "Screens that omit the theme argument fall back to isSystemInDarkTheme(), which overwrites the forced parameter further down. Answering true here covers those screens, and the paywalls and system-following components with them.",
      "method": ".method public static final z(Lyo0;)Z",
      "anchor": "    sget-object v0, Landroidx/compose/ui/platform/g;->a:Lrq0;\n",
      "original": "    sget-object v0, Landroidx/compose/ui/platform/g;->a:Lrq0;\n",
      "replacement": "    const/4 p0, 0x1\n\n    return p0\n\n    sget-object v0, Landroidx/compose/ui/platform/g;->a:Lrq0;\n",
      "marker": "patch:dark-theme:isSystemInDarkTheme",
      "returns": "Z"
    },
